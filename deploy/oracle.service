# systemd unit for the jyotish oracle (VDS deployment).
# Place at /etc/systemd/system/oracle.service and:
#   systemctl daemon-reload && systemctl enable --now oracle
# Configure Ollama separately (localhost:11434) or point to a remote one
# via OLLAMA_BASE_URL / JYOTISH_CHAT_MODEL & co. (see src/core/config.cpp).

[Unit]
Description=Jyotish Oracle HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/oracle
ExecStart=/opt/oracle/build/jyotish_server
Restart=always
RestartSec=3

# --- Required for the admin panel (/admin.html) ---
# Environment=JYOTISH_ADMIN_TOKEN=change-me-strong-token

# --- Optional knobs (defaults shown) ---
# Environment=JYOTISH_STORE_PATH=/opt/oracle/oracle_store.db
# Environment=JYOTISH_FREE_QUESTIONS=5
# Environment=JYOTISH_COINS_PER_PACK=10
# Environment=JYOTISH_COIN_PACK_PRICE_RUB=100
# Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
# Environment=JYOTISH_CHAT_MODEL=qwen2.5:7b-instruct

# Proxy NGINX/Caddy in front with TLS; bind to localhost:
Environment=JYOTISH_HOST=127.0.0.1
Environment=JYOTISH_PORT=8000

[Install]
WantedBy=multi-user.target